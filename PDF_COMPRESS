<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>PDF Compressor ✨</title>

<style>
*{
    box-sizing:border-box;
    margin:0;
    padding:0;
    font-family:Arial, Helvetica, sans-serif;
}

body{
    min-height:100vh;
    color:#fff;
    background:
        radial-gradient(circle at 10% 20%,rgba(0,255,255,.18),transparent 30%),
        radial-gradient(circle at 90% 10%,rgba(255,0,180,.18),transparent 30%),
        radial-gradient(circle at 50% 90%,rgba(0,120,255,.20),transparent 35%),
        linear-gradient(135deg,#070b19,#10152d 45%,#080b18);
    overflow-x:hidden;
}

/* Animated glow */
body::before{
    content:"";
    position:fixed;
    width:450px;
    height:450px;
    border-radius:50%;
    background:rgba(0,255,255,.08);
    filter:blur(80px);
    top:-150px;
    left:-150px;
    animation:floatGlow 8s infinite alternate;
    pointer-events:none;
}

body::after{
    content:"";
    position:fixed;
    width:450px;
    height:450px;
    border-radius:50%;
    background:rgba(255,0,200,.07);
    filter:blur(90px);
    bottom:-180px;
    right:-150px;
    animation:floatGlow2 10s infinite alternate;
    pointer-events:none;
}

@keyframes floatGlow{
    from{transform:translate(0,0);}
    to{transform:translate(120px,100px);}
}

@keyframes floatGlow2{
    from{transform:translate(0,0);}
    to{transform:translate(-100px,-80px);}
}

.container{
    width:min(1150px,94%);
    margin:35px auto;
    position:relative;
    z-index:2;
}

/* Header */
.header{
    text-align:center;
    padding:30px 20px;
    border:1px solid rgba(255,255,255,.15);
    border-radius:28px;
    background:rgba(255,255,255,.07);
    backdrop-filter:blur(20px);
    box-shadow:
        0 0 30px rgba(0,255,255,.10),
        inset 0 1px 0 rgba(255,255,255,.15);
    overflow:hidden;
    position:relative;
}

.header::before{
    content:"";
    position:absolute;
    top:0;
    left:-120%;
    width:60%;
    height:100%;
    background:linear-gradient(
        90deg,
        transparent,
        rgba(255,255,255,.20),
        transparent
    );
    transform:skewX(-20deg);
    animation:shine 4s infinite;
}

@keyframes shine{
    0%{left:-120%;}
    55%,100%{left:150%;}
}

.pdf-logo{
    width:82px;
    height:92px;
    margin:auto;
    display:flex;
    align-items:center;
    justify-content:center;
    border-radius:16px;
    background:linear-gradient(145deg,#e53935,#ff1744);
    box-shadow:
        0 0 12px #ff1744,
        0 0 30px rgba(255,23,68,.55),
        inset 0 2px 5px rgba(255,255,255,.35);
    font-size:22px;
    font-weight:900;
    letter-spacing:1px;
    position:relative;
}

.pdf-logo::after{
    content:"";
    position:absolute;
    right:0;
    top:0;
    width:25px;
    height:25px;
    background:#ff8a80;
    clip-path:polygon(0 0,100% 100%,100% 0);
    opacity:.7;
}

h1{
    margin-top:18px;
    font-size:clamp(30px,5vw,48px);
    background:linear-gradient(90deg,#fff,#66ffff,#fff,#ff80df,#fff);
    background-size:300%;
    -webkit-background-clip:text;
    background-clip:text;
    color:transparent;
    animation:textShine 5s linear infinite;
}

@keyframes textShine{
    to{background-position:300%;}
}

.subtitle{
    margin-top:8px;
    color:#c8d1ee;
    font-size:15px;
}

/* Main panel */
.panel{
    margin-top:24px;
    padding:25px;
    border-radius:25px;
    background:rgba(255,255,255,.065);
    border:1px solid rgba(255,255,255,.14);
    backdrop-filter:blur(18px);
    box-shadow:
        0 20px 60px rgba(0,0,0,.3),
        inset 0 1px 0 rgba(255,255,255,.10);
}

/* Drop zone */
.drop-zone{
    border:2px dashed rgba(80,230,255,.55);
    border-radius:22px;
    padding:45px 20px;
    text-align:center;
    cursor:pointer;
    background:rgba(0,180,255,.045);
    transition:.3s;
    position:relative;
    overflow:hidden;
}

.drop-zone:hover,
.drop-zone.dragover{
    border-color:#66ffff;
    background:rgba(0,255,255,.09);
    transform:translateY(-2px);
    box-shadow:
        0 0 25px rgba(0,255,255,.18),
        inset 0 0 30px rgba(0,255,255,.04);
}

.upload-icon{
    font-size:55px;
    margin-bottom:12px;
    filter:drop-shadow(0 0 12px rgba(255,80,80,.65));
}

.drop-zone h2{
    font-size:22px;
    margin-bottom:8px;
}

.drop-zone p{
    color:#aeb9d7;
    font-size:14px;
}

input[type=file]{
    display:none;
}

/* Settings */
.settings{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:18px;
    margin-top:22px;
}

.setting{
    padding:18px;
    border-radius:18px;
    background:rgba(0,0,0,.17);
    border:1px solid rgba(255,255,255,.10);
}

.setting label{
    display:block;
    margin-bottom:10px;
    font-weight:bold;
    color:#eafcff;
}

select,
input[type=number]{
    width:100%;
    padding:13px 15px;
    border-radius:12px;
    border:1px solid rgba(255,255,255,.15);
    background:#121a31;
    color:white;
    outline:none;
    font-size:15px;
}

select:focus,
input[type=number]:focus{
    border-color:#5fffff;
    box-shadow:0 0 12px rgba(0,255,255,.20);
}

/* Range */
.range-wrap{
    display:flex;
    align-items:center;
    gap:12px;
}

input[type=range]{
    width:100%;
    accent-color:#00e5ff;
}

.range-value{
    min-width:55px;
    text-align:center;
    padding:7px;
    border-radius:10px;
    background:rgba(0,255,255,.10);
    color:#6fffff;
    font-weight:bold;
}

/* Target */
.target-row{
    display:flex;
    gap:10px;
}

.target-row input{
    flex:1;
}

.unit{
    display:flex;
    align-items:center;
    padding:0 15px;
    border-radius:12px;
    background:rgba(255,255,255,.08);
    color:#9fffff;
    font-weight:bold;
}

/* Buttons */
.buttons{
    display:flex;
    gap:12px;
    flex-wrap:wrap;
    margin-top:22px;
}

button{
    border:0;
    cursor:pointer;
    color:#fff;
    font-weight:bold;
    padding:14px 22px;
    border-radius:14px;
    font-size:15px;
    transition:.25s;
    position:relative;
    overflow:hidden;
}

button::before{
    content:"";
    position:absolute;
    top:0;
    left:-100%;
    width:60%;
    height:100%;
    background:linear-gradient(
        90deg,
        transparent,
        rgba(255,255,255,.25),
        transparent
    );
    transform:skewX(-20deg);
    transition:.5s;
}

button:hover::before{
    left:130%;
}

button:hover{
    transform:translateY(-2px);
}

.compress-btn{
    background:linear-gradient(135deg,#00a8ff,#00e5ff);
    box-shadow:0 0 20px rgba(0,229,255,.30);
}

.download-btn{
    background:linear-gradient(135deg,#00b894,#00cec9);
    box-shadow:0 0 18px rgba(0,255,200,.22);
}

.clear-btn{
    background:linear-gradient(135deg,#ff416c,#ff4b2b);
    box-shadow:0 0 18px rgba(255,65,108,.22);
}

button:disabled{
    opacity:.45;
    cursor:not-allowed;
    transform:none;
}

/* Progress */
.progress-box{
    display:none;
    margin-top:22px;
}

.progress-text{
    display:flex;
    justify-content:space-between;
    margin-bottom:8px;
    font-size:13px;
    color:#cdd7f4;
}

.progress{
    width:100%;
    height:12px;
    background:rgba(255,255,255,.09);
    border-radius:20px;
    overflow:hidden;
}

.progress-bar{
    width:0%;
    height:100%;
    border-radius:20px;
    background:linear-gradient(90deg,#00e5ff,#7c4dff,#ff4fd8);
    box-shadow:0 0 15px rgba(0,229,255,.7);
    transition:.3s;
}

/* File cards */
.files{
    margin-top:25px;
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
    gap:15px;
}

.file-card{
    border-radius:18px;
    padding:17px;
    background:rgba(255,255,255,.055);
    border:1px solid rgba(255,255,255,.10);
    box-shadow:0 8px 25px rgba(0,0,0,.18);
    animation:cardIn .35s ease;
}

@keyframes cardIn{
    from{
        opacity:0;
        transform:translateY(10px);
    }
    to{
        opacity:1;
        transform:translateY(0);
    }
}

.file-top{
    display:flex;
    align-items:center;
    gap:12px;
}

.mini-pdf{
    width:48px;
    height:55px;
    display:flex;
    align-items:center;
    justify-content:center;
    border-radius:9px;
    background:linear-gradient(135deg,#e53935,#ff5252);
    font-size:12px;
    font-weight:900;
    box-shadow:0 0 12px rgba(255,60,60,.35);
    flex-shrink:0;
}

.file-name{
    white-space:nowrap;
    overflow:hidden;
    text-overflow:ellipsis;
    font-weight:bold;
}

.file-size{
    color:#9ba8ca;
    font-size:12px;
    margin-top:5px;
}

.status{
    margin-top:14px;
    padding-top:12px;
    border-top:1px solid rgba(255,255,255,.08);
    color:#b9c5e3;
    font-size:13px;
}

.result{
    margin-top:8px;
    font-weight:bold;
}

.saving{
    color:#6effc6;
}

/* Info */
.info{
    margin-top:22px;
    padding:17px;
    border-radius:16px;
    background:rgba(0,255,255,.045);
    border:1px solid rgba(0,255,255,.12);
    color:#bdc9e7;
    font-size:13px;
    line-height:1.7;
}

.info strong{
    color:#65ffff;
}

/* Footer */
.footer{
    text-align:center;
    margin:20px 0;
    color:#7986a8;
    font-size:12px;
}

/* Responsive */
@media(max-width:700px){
    .settings{
        grid-template-columns:1fr;
    }

    .panel{
        padding:16px;
    }

    .drop-zone{
        padding:35px 15px;
    }

    .buttons button{
        width:100%;
    }
}
</style>
</head>

<body>

<div class="container">

    <div class="header">

        <div class="pdf-logo">PDF</div>

        <h1>PDF COMPRESSOR ✨</h1>

        <div class="subtitle">
            Compress PDF files with a beautiful, fast & shining interface
        </div>

    </div>


    <div class="panel">

        <!-- Upload -->
        <label class="drop-zone" id="dropZone">

            <div class="upload-icon">📕</div>

            <h2>Select PDF Files</h2>

            <p>
                Click here or drag & drop your PDF files
            </p>

            <p style="margin-top:8px;">
                Multiple PDF files supported
            </p>

            <input
                type="file"
                id="fileInput"
                accept="application/pdf,.pdf"
                multiple
            >

        </label>


        <!-- Settings -->
        <div class="settings">

            <div class="setting">

                <label>🎯 Compression Level</label>

                <select id="compressionLevel">

                    <option value="low">
                        Low Compression — Better Quality
                    </option>

                    <option value="medium" selected>
                        Medium Compression — Recommended
                    </option>

                    <option value="high">
                        High Compression — Smaller File
                    </option>

                    <option value="maximum">
                        Maximum Compression — Smallest Possible
                    </option>

                </select>

            </div>


            <div class="setting">

                <label>📦 Target File Size</label>

                <div class="target-row">

                    <input
                        type="number"
                        id="targetKB"
                        value="500"
                        min="10"
                        max="50000"
                    >

                    <div class="unit">KB</div>

                </div>

            </div>


            <div class="setting">

                <label>🖼️ Image Quality</label>

                <div class="range-wrap">

                    <input
                        type="range"
                        id="quality"
                        min="20"
                        max="95"
                        value="70"
                    >

                    <div class="range-value" id="qualityValue">
                        70%
                    </div>

                </div>

            </div>


            <div class="setting">

                <label>📐 Page Scale</label>

                <select id="pageScale">

                    <option value="0.70">
                        70% — Maximum Compression
                    </option>

                    <option value="0.80">
                        80% — High Compression
                    </option>

                    <option value="0.90" selected>
                        90% — Recommended
                    </option>

                    <option value="1">
                        100% — Original Size
                    </option>

                </select>

            </div>

        </div>


        <!-- Buttons -->
        <div class="buttons">

            <button
                class="compress-btn"
                id="compressBtn"
                disabled
            >
                ⚡ COMPRESS PDF
            </button>

            <button
                class="download-btn"
                id="downloadAllBtn"
                disabled
            >
                📥 DOWNLOAD ALL
            </button>

            <button
                class="clear-btn"
                id="clearBtn"
            >
                🗑️ CLEAR ALL
            </button>

        </div>


        <!-- Progress -->
        <div class="progress-box" id="progressBox">

            <div class="progress-text">

                <span id="progressText">
                    Preparing...
                </span>

                <span id="progressPercent">
                    0%
                </span>

            </div>

            <div class="progress">

                <div
                    class="progress-bar"
                    id="progressBar"
                ></div>

            </div>

        </div>


        <!-- Files -->
        <div
            class="files"
            id="files"
        ></div>


        <div class="info">

            <strong>💡 How it works:</strong><br>

            Your PDF is processed directly in your browser.
            PDF pages are rendered and rebuilt with optimized
            image quality. No PDF file is uploaded to a server.

            <br><br>

            <strong>⚠️ Important:</strong>
            Text/vector-heavy PDFs may not always become smaller,
            while scanned/image-heavy PDFs generally benefit more
            from this type of compression.

        </div>

    </div>


    <div class="footer">
        ✨ PDF Compressor • Browser Based • No Server Upload
    </div>

</div>


<!-- PDF.js -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/4.10.38/pdf.min.mjs"
        type="module"></script>

<!-- jsPDF -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>


<script type="module">

import * as pdfjsLib
from "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/4.10.38/pdf.min.mjs";

pdfjsLib.GlobalWorkerOptions.workerSrc =
"https://cdnjs.cloudflare.com/ajax/libs/pdf.js/4.10.38/pdf.worker.min.mjs";


const fileInput =
document.getElementById("fileInput");

const dropZone =
document.getElementById("dropZone");

const filesContainer =
document.getElementById("files");

const compressBtn =
document.getElementById("compressBtn");

const downloadAllBtn =
document.getElementById("downloadAllBtn");

const clearBtn =
document.getElementById("clearBtn");

const compressionLevel =
document.getElementById("compressionLevel");

const quality =
document.getElementById("quality");

const qualityValue =
document.getElementById("qualityValue");

const targetKB =
document.getElementById("targetKB");

const pageScale =
document.getElementById("pageScale");

const progressBox =
document.getElementById("progressBox");

const progressBar =
document.getElementById("progressBar");

const progressText =
document.getElementById("progressText");

const progressPercent =
document.getElementById("progressPercent");


let selectedFiles = [];
let compressedFiles = [];


/* Quality slider */

quality.addEventListener("input", () => {

    qualityValue.textContent =
        quality.value + "%";

});


/* File selection */

fileInput.addEventListener("change", () => {

    addFiles([...fileInput.files]);

});


/* Drag & Drop */

["dragenter","dragover"].forEach(eventName => {

    dropZone.addEventListener(eventName, e => {

        e.preventDefault();

        dropZone.classList.add("dragover");

    });

});


["dragleave","drop"].forEach(eventName => {

    dropZone.addEventListener(eventName, e => {

        e.preventDefault();

        dropZone.classList.remove("dragover");

    });

});


dropZone.addEventListener("drop", e => {

    const files = [...e.dataTransfer.files]
        .filter(file =>
            file.type === "application/pdf" ||
            file.name.toLowerCase().endsWith(".pdf")
        );

    addFiles(files);

});


function addFiles(files){

    const pdfs = files.filter(file =>
        file.type === "application/pdf" ||
        file.name.toLowerCase().endsWith(".pdf")
    );

    selectedFiles.push(...pdfs);

    renderFiles();

    compressBtn.disabled =
        selectedFiles.length === 0;

    downloadAllBtn.disabled = true;

    compressedFiles = [];

}


function formatBytes(bytes){

    if(bytes < 1024)
        return bytes + " B";

    if(bytes < 1024 * 1024)
        return (bytes / 1024).toFixed(1) + " KB";

    return (bytes / (1024 * 1024)).toFixed(2) + " MB";

}


function renderFiles(){

    filesContainer.innerHTML = "";

    selectedFiles.forEach((file,index) => {

        const card =
        document.createElement("div");

        card.className = "file-card";

        card.innerHTML = `

            <div class="file-top">

                <div class="mini-pdf">
                    PDF
                </div>

                <div style="min-width:0">

                    <div class="file-name"
                         title="${escapeHTML(file.name)}">

                        ${escapeHTML(file.name)}

                    </div>

                    <div class="file-size">

                        Original:
                        ${formatBytes(file.size)}

                    </div>

                </div>

            </div>

            <div class="status"
                 id="status-${index}">

                ⏳ Ready to compress

            </div>

        `;

        filesContainer.appendChild(card);

    });

}


function escapeHTML(str){

    return str.replace(/[&<>"']/g, m => ({

        "&":"&amp;",
        "<":"&lt;",
        ">":"&gt;",
        '"':"&quot;",
        "'":"&#039;"

    })[m]);

}


/* Compression */

compressBtn.addEventListener("click", async () => {

    if(selectedFiles.length === 0)
        return;

    compressedFiles = [];

    compressBtn.disabled = true;
    downloadAllBtn.disabled = true;

    progressBox.style.display = "block";

    for(let i = 0; i < selectedFiles.length; i++){

        const file = selectedFiles[i];

        progressText.textContent =
            "Compressing " +
            (i + 1) +
            " of " +
            selectedFiles.length +
            "...";

        setProgress(
            Math.round((i / selectedFiles.length) * 100)
        );

        const result =
            await compressPDF(file, i);

        compressedFiles.push(result);

        setProgress(
            Math.round(
                ((i + 1) / selectedFiles.length) * 100
            )
        );

    }

    progressText.textContent =
        "Compression completed ✨";

    setProgress(100);

    compressBtn.disabled = false;
    downloadAllBtn.disabled =
        compressedFiles.length === 0;

});


async function compressPDF(file,index){

    const status =
        document.getElementById(
            "status-" + index
        );

    status.innerHTML =
        "⚙️ Reading PDF...";


    const arrayBuffer =
        await file.arrayBuffer();


    const pdf =
        await pdfjsLib.getDocument({
            data:arrayBuffer
        }).promise;


    const level =
        compressionLevel.value;


    let scale =
        parseFloat(pageScale.value);


    let jpegQuality =
        parseInt(quality.value) / 100;


    /* Adjust automatically */

    if(level === "low"){

        scale = 1;
        jpegQuality = Math.max(
            jpegQuality,
            .82
        );

    }

    if(level === "medium"){

        scale = .90;
        jpegQuality = Math.min(
            jpegQuality,
            .70
        );

    }

    if(level === "high"){

        scale = .78;
        jpegQuality = Math.min(
            jpegQuality,
            .55
        );

    }

    if(level === "maximum"){

        scale = .65;
        jpegQuality = Math.min(
            jpegQuality,
            .40
        );

    }


    let outputPdf = null;


    for(let pageNumber = 1;
        pageNumber <= pdf.numPages;
        pageNumber++){

        status.innerHTML =
            `⚙️ Processing page
             ${pageNumber} of
             ${pdf.numPages}...`;


        const page =
            await pdf.getPage(pageNumber);


        const viewport =
            page.getViewport({
                scale:scale
            });


        const canvas =
            document.createElement("canvas");


        const context =
            canvas.getContext("2d",{
                alpha:false
            });


        canvas.width =
            Math.ceil(viewport.width);

        canvas.height =
            Math.ceil(viewport.height);


        context.fillStyle =
            "#ffffff";

        context.fillRect(
            0,
            0,
            canvas.width,
            canvas.height
        );


        await page.render({

            canvasContext:context,
            viewport:viewport

        }).promise;


        const imageData =
            canvas.toDataURL(
                "image/jpeg",
                jpegQuality
            );


        const orientation =
            viewport.width >
            viewport.height
            ? "landscape"
            : "portrait";


        const { jsPDF } =
            window.jspdf;


        if(!outputPdf){

            outputPdf =
                new jsPDF({

                    orientation:
                        orientation,

                    unit:"pt",

                    format:[
                        viewport.width,
                        viewport.height
                    ],

                    compress:true

                });

        }else{

            outputPdf.addPage(
                [
                    viewport.width,
                    viewport.height
                ],
                orientation
            );

        }


        outputPdf.addImage(

            imageData,
            "JPEG",

            0,
            0,

            viewport.width,
            viewport.height,

            undefined,
            "FAST"

        );

    }


    status.innerHTML =
        "📦 Creating compressed PDF...";


    const blob =
        outputPdf.output("blob");


    const originalSize =
        file.size;

    const newSize =
        blob.size;


    const saving =
        ((1 - newSize / originalSize) * 100);


    const safeSaving =
        Math.max(0,saving);


    let message =
        `✅ Compressed:
         ${formatBytes(newSize)}`;


    if(saving > 0){

        message +=
            `<div class="result saving">
                🎉 Saved ${safeSaving.toFixed(1)}%
             </div>`;

    }else{

        message +=
            `<div class="result">
                ℹ️ New file is not smaller
             </div>`;

    }


    status.innerHTML = message;


    const outputName =
        file.name.replace(
            /\.pdf$/i,
            ""
        ) + "_compressed.pdf";


    return {

        name:outputName,
        blob:blob,
        originalSize:originalSize,
        compressedSize:newSize

    };

}


/* Progress */

function setProgress(value){

    value =
        Math.max(
            0,
            Math.min(100,value)
        );

    progressBar.style.width =
        value + "%";

    progressPercent.textContent =
        value + "%";

}


/* Download single */

function downloadFile(item){

    const url =
        URL.createObjectURL(item.blob);

    const a =
        document.createElement("a");

    a.href = url;

    a.download = item.name;

    document.body.appendChild(a);

    a.click();

    a.remove();

    setTimeout(() => {

        URL.revokeObjectURL(url);

    },1500);

}


/* Download all */

downloadAllBtn.addEventListener("click", async () => {

    if(!compressedFiles.length)
        return;

    for(let i=0;
        i<compressedFiles.length;
        i++){

        downloadFile(
            compressedFiles[i]
        );

        await new Promise(
            resolve =>
                setTimeout(resolve,500)
        );

    }

});


/* Clear */

clearBtn.addEventListener("click", () => {

    selectedFiles = [];

    compressedFiles = [];

    fileInput.value = "";

    filesContainer.innerHTML = "";

    progressBox.style.display = "none";

    setProgress(0);

    compressBtn.disabled = true;

    downloadAllBtn.disabled = true;

    progressText.textContent =
        "Preparing...";

});


</script>

</body>
</html>
